        "import random\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "num_rolls = 1000\n",
        "rolls = [random.randint(1,6) for i in range(num_rolls)]\n",
        "outcomes= list(range(1,6+1))\n",
        "\n",
        "experimental_probs = [rolls.count(face)/num_rolls for face in outcomes]\n",
        "theoretical_prob_single = 1/6\n",
        "theoretical_probs = [theoretical_prob_single] * len(outcomes) # Repeat for each outcome\n",
        "\n",
        "width = 0.35 # Define the width of the bars\n",
        "\n",
        "plt.figure(figsize=(8,6))\n",
        "\n",
        "# Adjust x-coordinates for experimental bars\n",
        "plt.bar([o - width/2 for o in outcomes], experimental_probs, width=width, label='Experimental', color='royalblue')\n",
        "\n",
        "# Adjust x-coordinates for theoretical bars\n",
        "plt.bar([o + width/2 for o in outcomes], theoretical_probs, width=width, label='Theoretical', color='orange', alpha=0.7)\n",
        "\n",
        "plt.xlabel('Dice Outcome')\n",
        "plt.ylabel('Probability')\n",
        "plt.title('Comparison of Experimental and Theoretical Probabilities (1000 Rolls)')\n",
        "plt.xticks(outcomes)\n",
        "plt.legend()\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.show()"
      ],
