        "import numpy as np\n",
        "x =np.array([1,2,3,4,5])\n",
        "y = np.array([2,5,10,17,26])\n",
        "coefficients= np.polyfit(x,y,2)\n",
        "a,b,c = coefficients\n",
        "print(\"polynomial curve fitting\")\n",
        "print(f\"fitted equation: y={a:.2f}x^2 +{b:.2f}x+{c:.2f}\")\n",
        "\n",
        "new_x=6\n",
        "predicted_y= np.polyval(coefficients,new_x)\n",
        "print(f\"prediction for x ={new_x}: y={predicted_y:.2f}\")"
      ],
